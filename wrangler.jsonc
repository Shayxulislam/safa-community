{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "safa-community-dev",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-15",
	"secrets": {
		"required": ["SUPABASE_SECRET_KEY"]
	},
	"vars": {
		"SUPABASE_URL": "https://YOUR_DEVELOPMENT_PROJECT.supabase.co",
		"SUPABASE_PUBLISHABLE_KEY": "YOUR_DEVELOPMENT_PUBLISHABLE_KEY"
	},
	"assets": {
		"directory": "./dist/",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"env": {
		"production": {
			"name": "safa-community",
			"vars": {
				"SUPABASE_URL": "https://esekwdgunftouzkcrqlx.supabase.co",
				"SUPABASE_PUBLISHABLE_KEY": "sb_publishable_n_Um54u3J2Zp7d-KBIWchQ_iYv_qRKy"
			},
			"secrets": {
				"required": ["SUPABASE_SECRET_KEY"]
			},
			"assets": {
				"directory": "./dist/",
				"binding": "ASSETS",
				"not_found_handling": "single-page-application",
				"run_worker_first": ["/api/*"]
			}
		}
	},
}
